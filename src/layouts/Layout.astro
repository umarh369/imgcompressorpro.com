---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  canonical?: string;
  noindex?: boolean;
  pageType?: 'website' | 'article';
  keywords?: string;
}

const {
  title,
  description,
  ogImage = 'https://imgcompressorpro.com/og-default.jpg',
  ogImageAlt = 'ImgCompressor Pro — Free Online Image Compressor Tool',
  canonical,
  noindex = false,
  pageType = 'website',
  keywords = 'image compressor, compress image online, online image compressor, free image compressor, image compressor online, reduce image size, photo compressor, compress jpg, compress png, compress webp, image optimizer, reduce image file size, bulk image compressor, image compression tool, optimize images for web, compress photos online, compress image without losing quality, image size reducer, website image optimizer, fast image compressor',
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title.includes('ImgCompressor Pro') ? title : `${title} | ImgCompressor Pro`;

const schemaOrg = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': 'https://imgcompressorpro.com/#app',
      name: 'ImgCompressor Pro',
      url: 'https://imgcompressorpro.com',
      description: 'Free online image compression tool. Compress JPG, PNG, and WebP images without losing quality.',
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://imgcompressorpro.com/#website',
      url: 'https://imgcompressorpro.com',
      name: 'ImgCompressor Pro',
      description: 'Professional image compression tool',
    },
  ],
};
---

<!doctype html>
<html lang="en" class="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="ImgCompressor Pro" />
    {noindex
      ? <meta name="robots" content="noindex,nofollow" />
      : <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />
    }

    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="ImgCompressor Pro" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@imgcompressorpro" />
    <meta name="twitter:creator" content="@imgcompressorpro" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="imgCompress" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#171717" />

    <!-- Font preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7449895389119472" crossorigin="anonymous" is:inline></script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WNLHZ4HKSK" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-WNLHZ4HKSK');
    </script>

    <!-- Dark mode — runs before paint to avoid flash -->
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem('theme');
          var m = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (s === 'dark' || (!s && m)) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-canvas-soft dark:bg-[#0a0a0a] text-ink dark:text-[#ededed] font-sans antialiased transition-colors duration-200">
    <slot />

    <script>
      // Expose global dark-mode toggle
      (window as any).__toggleDark = function () {
        const html = document.documentElement;
        const isDark = html.classList.toggle('dark');
        try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (_) {}
      };
    </script>
  </body>
</html>
