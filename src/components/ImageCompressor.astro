---
// ImageCompressor — fully client-side, no server uploads
---

<section id="compressor" aria-labelledby="compressor-heading" class="py-16 md:py-24">
  <div class="container-page">
    <!-- Section header -->
    <div class="text-center mb-10">
      <span class="inline-block text-xs font-mono uppercase tracking-widest text-mute dark:text-[#666] mb-3">
        Free &amp; Instant
      </span>
      <h2 id="compressor-heading" class="text-3xl md:text-4xl font-semibold text-ink dark:text-white tracking-tight -mb-0.5" style="letter-spacing: -1.28px;">
        Compress your images.
      </h2>
      <p class="mt-3 text-base text-body dark:text-[#a1a1a1] max-w-md mx-auto">
        Drop any JPG, PNG, or WebP — compression happens instantly in your browser. Nothing leaves your device.
      </p>
    </div>

    <!-- Tool card -->
    <div class="max-w-4xl mx-auto rounded-xl border border-hairline dark:border-[#1f1f1f] bg-canvas dark:bg-[#111] overflow-hidden" style="box-shadow: var(--shadow-pricing);">

      <!-- Settings bar -->
      <div class="px-6 py-4 border-b border-hairline dark:border-[#1f1f1f] flex flex-col sm:flex-row sm:items-center gap-4">
        <span class="text-sm font-medium text-ink dark:text-white shrink-0">Compression level</span>
        <div class="flex items-center gap-2 flex-wrap" role="radiogroup" aria-label="Compression level">
          <label class="compression-label">
            <input type="radio" name="quality" value="low" class="sr-only peer" />
            <span class="peer-checked:bg-ink peer-checked:text-white dark:peer-checked:bg-white dark:peer-checked:text-ink cursor-pointer flex items-center gap-1.5 h-8 px-3 rounded-full border border-hairline dark:border-[#2a2a2a] text-sm text-body dark:text-[#a1a1a1] hover:border-hairline-strong dark:hover:border-[#444] transition-all select-none">
              <span class="w-2 h-2 rounded-full bg-link inline-block shrink-0"></span>
              Low
            </span>
          </label>
          <label class="compression-label">
            <input type="radio" name="quality" value="balanced" class="sr-only peer" checked />
            <span class="peer-checked:bg-ink peer-checked:text-white dark:peer-checked:bg-white dark:peer-checked:text-ink cursor-pointer flex items-center gap-1.5 h-8 px-3 rounded-full border border-hairline dark:border-[#2a2a2a] text-sm text-body dark:text-[#a1a1a1] hover:border-hairline-strong dark:hover:border-[#444] transition-all select-none">
              <span class="w-2 h-2 rounded-full bg-warning inline-block shrink-0"></span>
              Balanced
            </span>
          </label>
          <label class="compression-label">
            <input type="radio" name="quality" value="maximum" class="sr-only peer" />
            <span class="peer-checked:bg-ink peer-checked:text-white dark:peer-checked:bg-white dark:peer-checked:text-ink cursor-pointer flex items-center gap-1.5 h-8 px-3 rounded-full border border-hairline dark:border-[#2a2a2a] text-sm text-body dark:text-[#a1a1a1] hover:border-hairline-strong dark:hover:border-[#444] transition-all select-none">
              <span class="w-2 h-2 rounded-full bg-error inline-block shrink-0"></span>
              Maximum
            </span>
          </label>
          <span id="quality-hint" class="text-xs text-mute dark:text-[#666] ml-1 hidden sm:inline">Recommended</span>
        </div>

        <!-- Bulk actions — visible when files selected -->
        <div id="bulk-actions" class="hidden ml-auto flex items-center gap-2">
          <span id="file-count-badge" class="text-xs font-mono bg-canvas-soft dark:bg-[#1a1a1a] border border-hairline dark:border-[#2a2a2a] rounded-full px-2 py-0.5 text-body dark:text-[#a1a1a1]">0 files</span>
          <button
            id="btn-compress-all"
            class="h-8 px-3 bg-ink dark:bg-white text-white dark:text-ink text-sm font-medium rounded-full hover:bg-[#2a2a2a] dark:hover:bg-[#e0e0e0] transition-colors"
          >
            Compress All
          </button>
          <button
            id="btn-download-all"
            class="hidden h-8 px-3 border border-hairline dark:border-[#2a2a2a] bg-canvas dark:bg-[#111] text-ink dark:text-white text-sm font-medium rounded-full hover:border-hairline-strong dark:hover:border-[#444] transition-colors"
          >
            Download All (.zip)
          </button>
          <button
            id="btn-clear-all"
            class="h-8 px-3 text-sm text-mute dark:text-[#666] hover:text-error transition-colors"
          >
            Clear
          </button>
        </div>
      </div>

      <!-- Drop zone -->
      <div
        id="drop-zone"
        role="button"
        tabindex="0"
        aria-label="Upload images: drag and drop or click to browse"
        class="relative mx-6 my-6 rounded-lg border-2 border-dashed border-hairline dark:border-[#2a2a2a] hover:border-hairline-strong dark:hover:border-[#444] bg-canvas-soft dark:bg-[#0d0d0d] transition-all duration-200 cursor-pointer group"
        style="min-height: 200px;"
      >
        <input
          type="file"
          id="file-input"
          accept="image/jpeg,image/jpg,image/png,image/webp"
          multiple
          class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
          aria-label="Upload images"
        />
        <div class="flex flex-col items-center justify-center gap-3 p-10 pointer-events-none">
          <div class="w-12 h-12 rounded-xl border border-hairline dark:border-[#2a2a2a] bg-canvas dark:bg-[#111] flex items-center justify-center group-hover:border-hairline-strong dark:group-hover:border-[#444] transition-colors">
            <svg class="w-6 h-6 text-body dark:text-[#a1a1a1]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
            </svg>
          </div>
          <div class="text-center">
            <p class="text-sm font-medium text-ink dark:text-white">
              Drop images here, or <span class="text-link">browse</span>
            </p>
            <p class="mt-1 text-xs text-mute dark:text-[#666]">
              Supports JPG, PNG, WebP &bull; Multiple files allowed
            </p>
          </div>
        </div>
        <!-- Drag-active overlay -->
        <div id="drag-overlay" class="hidden absolute inset-0 rounded-lg border-2 border-link bg-link-bg-soft/20 dark:bg-link/10 flex items-center justify-center">
          <p class="text-sm font-medium text-link">Release to upload</p>
        </div>
      </div>

      <!-- File list -->
      <div id="file-list" class="hidden px-6 pb-6 space-y-3"></div>

      <!-- Overall savings summary -->
      <div id="savings-summary" class="hidden mx-6 mb-6 rounded-lg border border-hairline dark:border-[#1f1f1f] bg-canvas-soft dark:bg-[#0d0d0d] p-4 flex flex-col sm:flex-row items-center gap-4 text-center sm:text-left">
        <div class="flex-1">
          <p class="text-xs text-mute dark:text-[#666] uppercase tracking-wider font-mono mb-1">Total saved</p>
          <p id="total-saved" class="text-2xl font-semibold text-ink dark:text-white tracking-tight" style="letter-spacing:-0.5px">0 KB</p>
        </div>
        <div class="w-px h-8 bg-hairline dark:bg-[#1f1f1f] hidden sm:block"></div>
        <div class="flex-1">
          <p class="text-xs text-mute dark:text-[#666] uppercase tracking-wider font-mono mb-1">Average reduction</p>
          <p id="avg-reduction" class="text-2xl font-semibold gradient-text-develop tracking-tight" style="letter-spacing:-0.5px">0%</p>
        </div>
        <div class="w-px h-8 bg-hairline dark:bg-[#1f1f1f] hidden sm:block"></div>
        <div class="flex-1">
          <p class="text-xs text-mute dark:text-[#666] uppercase tracking-wider font-mono mb-1">Files compressed</p>
          <p id="files-compressed" class="text-2xl font-semibold text-ink dark:text-white tracking-tight" style="letter-spacing:-0.5px">0</p>
        </div>
      </div>
    </div>

    <!-- Trust badges -->
    <div class="mt-6 flex flex-wrap justify-center gap-4">
      {[
        '🔒 100% private — no uploads',
        '⚡ Instant processing',
        '🌐 Works offline',
        '♾️ No file limit',
      ].map(badge => (
        <span class="text-xs text-mute dark:text-[#666] font-mono">{badge}</span>
      ))}
    </div>
  </div>
</section>

<!-- Comparison modal -->
<div
  id="compare-modal"
  class="hidden fixed inset-0 z-50 bg-ink/80 dark:bg-black/90 backdrop-blur-sm flex items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-label="Before/After comparison"
>
  <div class="relative w-full max-w-3xl rounded-xl bg-canvas dark:bg-[#111] border border-hairline dark:border-[#2a2a2a] overflow-hidden" style="box-shadow: var(--shadow-modal);">
    <div class="flex items-center justify-between px-5 py-4 border-b border-hairline dark:border-[#1f1f1f]">
      <h3 class="text-sm font-medium text-ink dark:text-white">Before / After</h3>
      <button id="close-modal" aria-label="Close comparison" class="w-7 h-7 flex items-center justify-center rounded-full hover:bg-canvas-soft dark:hover:bg-[#1a1a1a] text-body dark:text-[#a1a1a1] transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="p-5">
      <!-- Slider -->
      <div id="compare-container" class="relative rounded-md overflow-hidden select-none bg-[#888] bg-[repeating-conic-gradient(#aaa_0%_25%,#888_0%_50%)] bg-[length:20px_20px]" style="aspect-ratio:16/9;">
        <img id="compare-after"  alt="Compressed image" class="absolute inset-0 w-full h-full object-contain" />
        <div id="compare-clip" class="absolute inset-0 overflow-hidden" style="clip-path:inset(0 50% 0 0);">
          <img id="compare-before" alt="Original image"    class="absolute inset-0 w-full h-full object-contain" />
        </div>
        <!-- Divider -->
        <div id="compare-divider" class="absolute top-0 bottom-0 w-0.5 bg-white shadow-modal cursor-ew-resize" style="left:50%;">
          <div class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-white shadow-modal flex items-center justify-center">
            <svg class="w-4 h-4 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M8 9l-3 3 3 3M16 9l3 3-3 3"/></svg>
          </div>
        </div>
        <!-- Labels -->
        <span class="absolute top-3 left-3 text-xs font-mono bg-black/60 text-white rounded px-2 py-0.5 pointer-events-none">Before</span>
        <span class="absolute top-3 right-3 text-xs font-mono bg-black/60 text-white rounded px-2 py-0.5 pointer-events-none">After</span>
      </div>
      <!-- Info row -->
      <div class="mt-4 grid grid-cols-2 gap-3 text-center">
        <div class="rounded-md bg-canvas-soft dark:bg-[#1a1a1a] border border-hairline dark:border-[#2a2a2a] p-3">
          <p class="text-xs text-mute dark:text-[#666] font-mono mb-1">ORIGINAL</p>
          <p id="modal-original-size" class="text-base font-semibold text-ink dark:text-white">—</p>
        </div>
        <div class="rounded-md bg-canvas-soft dark:bg-[#1a1a1a] border border-hairline dark:border-[#2a2a2a] p-3">
          <p class="text-xs text-mute dark:text-[#666] font-mono mb-1">COMPRESSED</p>
          <p id="modal-compressed-size" class="text-base font-semibold gradient-text-develop">—</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // ─── Types & constants ────────────────────────────────────────────────────
  interface CompressionResult {
    file: File;
    blob: Blob;
    originalSize: number;
    compressedSize: number;
    savings: number;
    originalUrl: string;
    compressedUrl: string;
    width: number;
    height: number;
  }

  type Quality = 'low' | 'balanced' | 'maximum';

  const QUALITY_MAP: Record<Quality, { jpeg: number; webp: number }> = {
    low:      { jpeg: 0.92, webp: 0.92 },
    balanced: { jpeg: 0.80, webp: 0.80 },
    maximum:  { jpeg: 0.60, webp: 0.60 },
  };

  // ─── State ────────────────────────────────────────────────────────────────
  const state = {
    files: [] as File[],
    results: new Map<string, CompressionResult>(),
  };

  // ─── DOM refs ─────────────────────────────────────────────────────────────
  const dropZone     = document.getElementById('drop-zone')!;
  const fileInput    = document.getElementById('file-input') as HTMLInputElement;
  const dragOverlay  = document.getElementById('drag-overlay')!;
  const fileList     = document.getElementById('file-list')!;
  const bulkActions  = document.getElementById('bulk-actions')!;
  const fileCountBadge = document.getElementById('file-count-badge')!;
  const btnCompressAll = document.getElementById('btn-compress-all')!;
  const btnDownloadAll = document.getElementById('btn-download-all')!;
  const btnClearAll  = document.getElementById('btn-clear-all')!;
  const savingsSummary = document.getElementById('savings-summary')!;
  const totalSavedEl  = document.getElementById('total-saved')!;
  const avgReductionEl = document.getElementById('avg-reduction')!;
  const filesCompressedEl = document.getElementById('files-compressed')!;

  // ─── Helpers ──────────────────────────────────────────────────────────────
  function formatBytes(bytes: number): string {
    if (bytes === 0) return '0 B';
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
  }

  function getQuality(): Quality {
    const checked = document.querySelector<HTMLInputElement>('input[name="quality"]:checked');
    return (checked?.value as Quality) ?? 'balanced';
  }

  function fileKey(file: File): string {
    return `${file.name}-${file.size}-${file.lastModified}`;
  }

  // ─── Compression ──────────────────────────────────────────────────────────
  async function compressImage(file: File, quality: Quality): Promise<CompressionResult> {
    const q = QUALITY_MAP[quality];
    return new Promise((resolve, reject) => {
      const img = new Image();
      const originalUrl = URL.createObjectURL(file);

      img.onload = () => {
        const canvas = document.createElement('canvas');
        canvas.width  = img.naturalWidth;
        canvas.height = img.naturalHeight;
        const ctx = canvas.getContext('2d');
        if (!ctx) { reject(new Error('Canvas not supported')); return; }
        ctx.drawImage(img, 0, 0);

        const mime = file.type === 'image/webp' ? 'image/webp'
                   : file.type === 'image/png'  ? 'image/png'
                   : 'image/jpeg';
        const outputQ = mime === 'image/webp' ? q.webp : mime === 'image/jpeg' ? q.jpeg : undefined;

        canvas.toBlob(blob => {
          if (!blob) { reject(new Error('Compression failed')); return; }
          const compressedUrl = URL.createObjectURL(blob);
          resolve({
            file, blob,
            originalSize:   file.size,
            compressedSize: blob.size,
            savings: Math.max(0, ((file.size - blob.size) / file.size) * 100),
            originalUrl,
            compressedUrl,
            width:  img.naturalWidth,
            height: img.naturalHeight,
          });
        }, mime, outputQ);
      };

      img.onerror = () => reject(new Error('Failed to load image'));
      img.src = originalUrl;
    });
  }

  // ─── Render file card ─────────────────────────────────────────────────────
  function createFileCard(file: File, key: string): HTMLElement {
    const card = document.createElement('div');
    card.id = `card-${key}`;
    card.className = 'file-card rounded-lg border border-hairline dark:border-[#1f1f1f] bg-canvas-soft dark:bg-[#0d0d0d] overflow-hidden';

    const ext = file.name.split('.').pop()?.toUpperCase() ?? '?';

    card.innerHTML = `
      <div class="flex items-center gap-4 p-4">
        <div class="w-12 h-12 rounded-md bg-canvas dark:bg-[#1a1a1a] border border-hairline dark:border-[#2a2a2a] flex items-center justify-center shrink-0 overflow-hidden" id="thumb-${key}">
          <span class="text-xs font-mono text-mute dark:text-[#666]">${ext}</span>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-ink dark:text-white truncate">${file.name}</p>
          <p class="text-xs text-mute dark:text-[#666] mt-0.5">${formatBytes(file.size)} &bull; ${ext}</p>
        </div>
        <div id="status-${key}" class="flex items-center gap-2">
          <button
            class="btn-compress h-8 px-3 bg-ink dark:bg-white text-white dark:text-ink text-xs font-medium rounded-full hover:bg-[#2a2a2a] dark:hover:bg-[#e0e0e0] transition-colors"
            data-key="${key}"
          >
            Compress
          </button>
          <button
            class="btn-remove w-7 h-7 flex items-center justify-center rounded-full hover:bg-error-soft dark:hover:bg-red-900/30 text-mute dark:text-[#666] hover:text-error transition-colors"
            data-key="${key}"
            aria-label="Remove ${file.name}"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
      <div id="result-${key}" class="hidden border-t border-hairline dark:border-[#1f1f1f]"></div>
    `;

    // Thumbnail preview
    const reader = new FileReader();
    reader.onload = e => {
      const thumb = document.getElementById(`thumb-${key}`) as HTMLElement;
      thumb.innerHTML = `<img src="${e.target?.result}" alt="" class="w-full h-full object-cover" />`;
    };
    reader.readAsDataURL(file);

    // Compress button
    card.querySelector<HTMLButtonElement>('.btn-compress')?.addEventListener('click', async () => {
      await compressOne(key, file, card);
    });

    // Remove button
    card.querySelector<HTMLButtonElement>('.btn-remove')?.addEventListener('click', () => {
      removeFile(key, card);
    });

    return card;
  }

  async function compressOne(key: string, file: File, card: HTMLElement) {
    const statusEl  = document.getElementById(`status-${key}`)!;
    const resultEl  = document.getElementById(`result-${key}`)!;

    // Spinner
    statusEl.innerHTML = `
      <span class="flex items-center gap-2 text-xs text-mute dark:text-[#666] font-mono">
        <span class="w-4 h-4 border-2 border-hairline border-t-ink dark:border-t-white rounded-full animate-spin"></span>
        Compressing…
      </span>
    `;

    try {
      const quality = getQuality();
      const result  = await compressImage(file, quality);
      state.results.set(key, result);

      const pct  = result.savings.toFixed(1);
      const saved = formatBytes(result.originalSize - result.compressedSize);

      statusEl.innerHTML = `
        <span class="text-xs font-mono text-success font-medium">−${pct}%</span>
        <button
          class="btn-download h-8 px-3 border border-hairline dark:border-[#2a2a2a] bg-canvas dark:bg-[#111] text-ink dark:text-white text-xs font-medium rounded-full hover:border-hairline-strong dark:hover:border-[#444] transition-colors"
          data-key="${key}"
        >
          Download
        </button>
      `;

      resultEl.innerHTML = `
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
          <span class="text-xs text-mute dark:text-[#666] font-mono">
            ${result.width}&times;${result.height}px &bull; ${file.type.split('/')[1].toUpperCase()}
          </span>
          <span class="text-xs text-mute dark:text-[#666]">
            <span class="line-through">${formatBytes(result.originalSize)}</span>
            &rarr;
            <span class="text-ink dark:text-white font-medium">${formatBytes(result.compressedSize)}</span>
            <span class="text-success ml-1">↓ ${saved}</span>
          </span>
          <button
            class="btn-compare text-xs text-link hover:text-link-deep transition-colors"
            data-key="${key}"
          >
            Compare ↔
          </button>
        </div>
      `;
      resultEl.classList.remove('hidden');

      // Wire download + compare
      card.querySelector<HTMLButtonElement>('.btn-download')?.addEventListener('click', () => {
        downloadResult(key);
      });
      card.querySelector<HTMLButtonElement>('.btn-compare')?.addEventListener('click', () => {
        openCompare(key);
      });

      updateSummary();
      updateBulkUI();
    } catch (err) {
      statusEl.innerHTML = `<span class="text-xs text-error font-mono">Failed</span>`;
    }
  }

  function removeFile(key: string, card: HTMLElement) {
    const idx = state.files.findIndex(f => fileKey(f) === key);
    if (idx !== -1) state.files.splice(idx, 1);

    const res = state.results.get(key);
    if (res) {
      URL.revokeObjectURL(res.originalUrl);
      URL.revokeObjectURL(res.compressedUrl);
      state.results.delete(key);
    }

    card.remove();
    updateBulkUI();
    updateSummary();

    if (state.files.length === 0) {
      fileList.classList.add('hidden');
    }
  }

  function downloadResult(key: string) {
    const result = state.results.get(key);
    if (!result) return;
    const ext = result.file.type === 'image/webp' ? 'webp'
              : result.file.type === 'image/png'  ? 'png' : 'jpg';
    const name = result.file.name.replace(/\.[^.]+$/, '') + '-compressed.' + ext;
    const a = document.createElement('a');
    a.href = result.compressedUrl;
    a.download = name;
    a.click();
  }

  // ─── Comparison modal ─────────────────────────────────────────────────────
  const compareModal   = document.getElementById('compare-modal')!;
  const compareClip    = document.getElementById('compare-clip') as HTMLElement;
  const compareDivider = document.getElementById('compare-divider') as HTMLElement;
  const compareAfter   = document.getElementById('compare-after') as HTMLImageElement;
  const compareBefore  = document.getElementById('compare-before') as HTMLImageElement;
  const modalOrigEl    = document.getElementById('modal-original-size')!;
  const modalCompEl    = document.getElementById('modal-compressed-size')!;
  const closeModalBtn  = document.getElementById('close-modal')!;

  function openCompare(key: string) {
    const result = state.results.get(key);
    if (!result) return;

    compareAfter.src  = result.compressedUrl;
    compareBefore.src = result.originalUrl;
    modalOrigEl.textContent  = formatBytes(result.originalSize);
    modalCompEl.textContent  = `${formatBytes(result.compressedSize)} (−${result.savings.toFixed(1)}%)`;

    compareModal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  closeModalBtn.addEventListener('click', closeCompare);
  compareModal.addEventListener('click', e => { if (e.target === compareModal) closeCompare(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeCompare(); });

  function closeCompare() {
    compareModal.classList.add('hidden');
    document.body.style.overflow = '';
  }

  // Slider drag logic
  let dragging = false;
  const container = document.getElementById('compare-container')!;

  function setSlider(x: number) {
    const rect = container.getBoundingClientRect();
    const pct  = Math.min(100, Math.max(0, ((x - rect.left) / rect.width) * 100));
    compareDivider.style.left    = `${pct}%`;
    compareClip.style.clipPath   = `inset(0 ${100 - pct}% 0 0)`;
  }

  compareDivider.addEventListener('mousedown',  () => { dragging = true; });
  document.addEventListener('mousemove', e => { if (dragging) setSlider(e.clientX); });
  document.addEventListener('mouseup',   ()  => { dragging = false; });

  compareDivider.addEventListener('touchstart',  e => { dragging = true; e.preventDefault(); }, { passive: false });
  document.addEventListener('touchmove', e => { if (dragging) setSlider(e.touches[0].clientX); }, { passive: true });
  document.addEventListener('touchend',  ()  => { dragging = false; });

  // ─── Bulk download (ZIP via dynamic CDN import) ───────────────────────────
  btnDownloadAll.addEventListener('click', async () => {
    const results = [...state.results.values()];
    if (!results.length) return;

    btnDownloadAll.textContent = 'Zipping…';
    (btnDownloadAll as HTMLButtonElement).disabled = true;

    try {
      // @ts-ignore — loaded from CDN
      const JSZip = (await import('https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js')).default;
      const zip = new JSZip();

      await Promise.all(results.map(async r => {
        const ext  = r.file.type === 'image/webp' ? 'webp' : r.file.type === 'image/png' ? 'png' : 'jpg';
        const name = r.file.name.replace(/\.[^.]+$/, '') + '-compressed.' + ext;
        zip.file(name, r.blob);
      }));

      const zipBlob = await zip.generateAsync({ type: 'blob' });
      const url = URL.createObjectURL(zipBlob);
      const a   = document.createElement('a');
      a.href = url; a.download = 'compressed-images.zip'; a.click();
      setTimeout(() => URL.revokeObjectURL(url), 5000);
    } catch {
      // Fallback: download individually
      results.forEach((_, i) => {
        setTimeout(() => downloadResult([...state.results.keys()][i]), i * 300);
      });
    } finally {
      btnDownloadAll.textContent = 'Download All (.zip)';
      (btnDownloadAll as HTMLButtonElement).disabled = false;
    }
  });

  // ─── Compress all ─────────────────────────────────────────────────────────
  btnCompressAll.addEventListener('click', async () => {
    const pending = state.files.filter(f => !state.results.has(fileKey(f)));
    if (!pending.length) return;

    btnCompressAll.textContent = 'Compressing…';
    (btnCompressAll as HTMLButtonElement).disabled = true;

    for (const file of pending) {
      const key  = fileKey(file);
      const card = document.getElementById(`card-${key}`);
      if (card) await compressOne(key, file, card);
    }

    btnCompressAll.textContent = 'Compress All';
    (btnCompressAll as HTMLButtonElement).disabled = false;
  });

  // ─── Clear all ────────────────────────────────────────────────────────────
  btnClearAll.addEventListener('click', () => {
    state.results.forEach(r => {
      URL.revokeObjectURL(r.originalUrl);
      URL.revokeObjectURL(r.compressedUrl);
    });
    state.files = [];
    state.results.clear();
    fileList.innerHTML = '';
    fileList.classList.add('hidden');
    savingsSummary.classList.add('hidden');
    updateBulkUI();
  });

  // ─── File handling ────────────────────────────────────────────────────────
  function addFiles(files: FileList | File[]) {
    const allowed = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
    const newFiles = [...files].filter(f => allowed.includes(f.type));
    if (!newFiles.length) return;

    newFiles.forEach(file => {
      const key = fileKey(file);
      if (state.files.some(f => fileKey(f) === key)) return;
      state.files.push(file);

      const card = createFileCard(file, key);
      fileList.appendChild(card);
    });

    fileList.classList.remove('hidden');
    updateBulkUI();
    fileInput.value = '';
  }

  fileInput.addEventListener('change', () => {
    if (fileInput.files) addFiles(fileInput.files);
  });

  // Drag and drop
  dropZone.addEventListener('dragover', e => {
    e.preventDefault();
    dragOverlay.classList.remove('hidden');
  });
  dropZone.addEventListener('dragleave', () => dragOverlay.classList.add('hidden'));
  dropZone.addEventListener('drop', e => {
    e.preventDefault();
    dragOverlay.classList.add('hidden');
    if (e.dataTransfer?.files) addFiles(e.dataTransfer.files);
  });

  // Keyboard activation
  dropZone.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); }
  });

  // ─── UI state helpers ─────────────────────────────────────────────────────
  function updateBulkUI() {
    const count = state.files.length;
    if (count === 0) {
      bulkActions.classList.add('hidden');
      return;
    }
    bulkActions.classList.remove('hidden');
    fileCountBadge.textContent = `${count} file${count !== 1 ? 's' : ''}`;

    const doneCount = state.results.size;
    if (doneCount > 0) btnDownloadAll.classList.remove('hidden');
    else btnDownloadAll.classList.add('hidden');
  }

  function updateSummary() {
    if (state.results.size === 0) {
      savingsSummary.classList.add('hidden');
      return;
    }
    savingsSummary.classList.remove('hidden');
    let totalOrig = 0, totalComp = 0;
    state.results.forEach(r => { totalOrig += r.originalSize; totalComp += r.compressedSize; });
    const totalSaved = totalOrig - totalComp;
    const avgPct = ((totalSaved / totalOrig) * 100).toFixed(1);

    totalSavedEl.textContent      = formatBytes(totalSaved);
    avgReductionEl.textContent     = `${avgPct}%`;
    filesCompressedEl.textContent  = String(state.results.size);
  }

  // Update quality hint label
  document.querySelectorAll<HTMLInputElement>('input[name="quality"]').forEach(radio => {
    radio.addEventListener('change', () => {
      const hint = document.getElementById('quality-hint')!;
      hint.textContent = radio.value === 'balanced' ? 'Recommended'
                       : radio.value === 'low'      ? 'Best quality'
                       : 'Smallest size';
    });
  });
</script>
