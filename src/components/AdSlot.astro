---
interface Props {
  slot?: 'banner' | 'rectangle' | 'leaderboard';
  label?: string;
  class?: string;
}
const { slot = 'banner', label = 'Advertisement', class: className = '' } = Astro.props;

const sizes: Record<string, string> = {
  banner:      'h-[90px] max-w-[728px]',
  rectangle:   'h-[250px] max-w-[300px]',
  leaderboard: 'h-[90px] w-full',
};
---

<!-- AdSense slot placeholder — replace data-ad-* with real values -->
<div class:list={['ad-slot-wrapper flex justify-center my-8', className]}>
  <div
    class:list={[
      'ad-slot relative overflow-hidden rounded-md border border-dashed border-hairline dark:border-[#2a2a2a] bg-canvas-soft dark:bg-[#111] flex items-center justify-center w-full',
      sizes[slot],
    ]}
    aria-hidden="true"
    role="presentation"
  >
    <span class="text-xs font-mono text-mute dark:text-[#444] select-none">{label}</span>
    <!-- Uncomment and fill in your AdSense code here:
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client="ca-pub-XXXXXXXXXX"
      data-ad-slot="XXXXXXXXXX"
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    -->
  </div>
</div>
