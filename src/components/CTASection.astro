---
interface Props {
  headline?: string;
  description?: string;
  cta?: string;
  ctaHref?: string;
}

const {
  headline    = 'Start compressing for free.',
  description = 'No account. No upload. No waiting. Just drop your images and save up to 85% on file size — instantly.',
  cta         = 'Compress Images Now',
  ctaHref     = '#compressor',
} = Astro.props;
---

<section class="py-20 md:py-28 bg-ink dark:bg-[#0a0a0a] relative overflow-hidden">
  <!-- Mesh gradient on dark -->
  <div
    class="mesh-gradient absolute inset-0 pointer-events-none"
    aria-hidden="true"
    style="opacity: 0.25;"
  ></div>

  <div class="container-page relative text-center">
    <span class="text-xs font-mono uppercase tracking-widest text-[#ffffff33] block mb-3">
      Get started
    </span>
    <h2
      class="text-3xl md:text-5xl font-semibold text-white tracking-tight mb-4"
      style="letter-spacing: -2px;"
    >
      {headline}
    </h2>
    <p class="text-base md:text-lg text-[#ffffff80] max-w-md mx-auto mb-8 leading-relaxed">
      {description}
    </p>
    <a
      href={ctaHref}
      class="inline-flex items-center gap-2 h-12 px-7 bg-white text-ink font-medium text-base rounded-full hover:bg-[#e5e5e5] transition-colors duration-150 shadow-subtle"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
      </svg>
      {cta}
    </a>

    <!-- Social proof -->
    <div class="mt-10 flex flex-wrap justify-center gap-6">
      {[
        { value: '50K+', label: 'images compressed daily' },
        { value: '98%', label: 'average quality preserved' },
        { value: '0', label: 'images stored on our servers' },
      ].map(s => (
        <div class="text-center">
          <p class="text-xl font-semibold text-white tracking-tight" style="letter-spacing:-0.5px">{s.value}</p>
          <p class="text-xs font-mono text-[#ffffff60]">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
