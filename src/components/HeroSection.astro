---
interface Props {
  headline?: string;
  subheadline?: string;
  cta?: string;
  ctaHref?: string;
}

const {
  headline   = 'Compress images without losing quality.',
  subheadline = 'Free, instant image compression for JPG, PNG, and WebP. Your images are processed in your browser — nothing is uploaded to a server.',
  cta        = 'Compress Images Now',
  ctaHref    = '#compressor',
} = Astro.props;
---

<section class="relative overflow-hidden bg-canvas dark:bg-[#0a0a0a] pt-20 pb-16 md:pt-28 md:pb-20">
  <!-- Mesh gradient backdrop -->
  <div
    class="mesh-gradient absolute inset-0 pointer-events-none"
    aria-hidden="true"
    style="opacity: 0.7;"
  ></div>
  <!-- Subtle grid overlay -->
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.03] dark:opacity-[0.07]"
    style="background-image: linear-gradient(#171717 1px, transparent 1px), linear-gradient(90deg, #171717 1px, transparent 1px); background-size: 40px 40px;"
    aria-hidden="true"
  ></div>

  <div class="container-page relative text-center">

    <!-- Announcement badge -->
    <div class="inline-flex items-center gap-2 bg-canvas-soft dark:bg-[#111] border border-hairline dark:border-[#2a2a2a] rounded-full px-3 py-1.5 mb-6 text-xs font-mono text-body dark:text-[#a1a1a1]">
      <span class="w-1.5 h-1.5 rounded-full bg-success inline-block animate-pulse"></span>
      100% free &bull; No account required &bull; No file size limit
    </div>

    <!-- Headline -->
    <h1
      class="text-4xl sm:text-5xl md:text-6xl font-semibold text-ink dark:text-white max-w-3xl mx-auto leading-none tracking-tight"
      style="letter-spacing: -2.4px;"
    >
      {headline}
    </h1>

    <!-- Sub-headline -->
    <p class="mt-5 text-base sm:text-lg text-body dark:text-[#a1a1a1] max-w-xl mx-auto leading-relaxed">
      {subheadline}
    </p>

    <!-- CTA row -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <a
        href={ctaHref}
        class="inline-flex items-center gap-2 h-12 px-6 bg-ink dark:bg-white text-white dark:text-ink font-medium text-base rounded-full hover:bg-[#2a2a2a] dark:hover:bg-[#e0e0e0] transition-colors duration-150 shadow-subtle"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
        </svg>
        {cta}
      </a>
      <a
        href="#features"
        class="inline-flex items-center h-12 px-6 border border-hairline dark:border-[#2a2a2a] bg-canvas dark:bg-[#111] text-ink dark:text-white font-medium text-base rounded-full hover:border-hairline-strong dark:hover:border-[#444] transition-colors duration-150"
      >
        Learn more
      </a>
    </div>

    <!-- Stats row -->
    <div class="mt-12 grid grid-cols-3 divide-x divide-hairline dark:divide-[#1f1f1f] max-w-xl mx-auto">
      {[
        { value: '70%', label: 'Average reduction' },
        { value: '<1s', label: 'Processing time' },
        { value: '∞', label: 'Files at once' },
      ].map(stat => (
        <div class="px-6 py-3 text-center">
          <p class="text-2xl font-semibold text-ink dark:text-white tracking-tight" style="letter-spacing:-0.5px">{stat.value}</p>
          <p class="mt-0.5 text-xs text-mute dark:text-[#666] font-mono">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Bottom fade -->
  <div
    class="absolute bottom-0 left-0 right-0 h-24 pointer-events-none"
    style="background: linear-gradient(to bottom, transparent, var(--color-canvas-soft));"
    aria-hidden="true"
  ></div>
</section>
