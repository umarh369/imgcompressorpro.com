---
const features = [
  {
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    gradient: 'from-[#007cf0] to-[#00dfd8]',
    title: 'Instant Processing',
    description: 'Compression happens in milliseconds using your browser\'s built-in canvas engine. No waiting, no uploading.',
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>`,
    gradient: 'from-[#7928ca] to-[#ff0080]',
    title: '100% Private',
    description: 'Your images never leave your device. No server uploads, no storage, no privacy risk. Works fully offline.',
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    gradient: 'from-[#ff4d4d] to-[#f9cb28]',
    title: 'Quality Presets',
    description: 'Three intelligent presets — Low, Balanced, and Maximum — so you always get the right size/quality tradeoff.',
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>`,
    gradient: 'from-[#007cf0] to-[#7928ca]',
    title: 'Before/After Compare',
    description: 'Drag the comparison slider to see exactly how much quality you\'re keeping versus how much size you\'re saving.',
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>`,
    gradient: 'from-[#00dfd8] to-[#50e3c2]',
    title: 'Bulk Compression',
    description: 'Upload dozens of images at once. Compress them all in a single click and download as a convenient ZIP file.',
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>`,
    gradient: 'from-[#ff0080] to-[#f9cb28]',
    title: 'Detailed Stats',
    description: 'See original size, compressed size, dimensions, file type, and exact percentage saved for every image.',
  },
];
---

<section id="features" class="py-20 md:py-28 bg-canvas-soft dark:bg-[#0a0a0a]">
  <div class="container-page">
    <div class="text-center mb-14">
      <span class="text-xs font-mono uppercase tracking-widest text-mute dark:text-[#666] block mb-3">
        Features
      </span>
      <h2
        class="text-3xl md:text-4xl font-semibold text-ink dark:text-white tracking-tight"
        style="letter-spacing: -1.28px;"
      >
        Everything you need to compress images.
      </h2>
      <p class="mt-3 text-base text-body dark:text-[#a1a1a1] max-w-md mx-auto">
        Professional-grade compression with zero compromise — no sign-up, no limits, no uploads.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {features.map(feat => (
        <div
          class="rounded-lg border border-hairline dark:border-[#1f1f1f] bg-canvas dark:bg-[#111] p-6 hover:border-hairline-strong dark:hover:border-[#333] transition-all duration-200 group"
          style="box-shadow: var(--shadow-card);"
        >
          <div class={`w-9 h-9 rounded-lg bg-gradient-to-br ${feat.gradient} flex items-center justify-center text-white mb-4 shadow-subtle`}
            set:html={feat.icon}
          />
          <h3 class="text-base font-semibold text-ink dark:text-white mb-2">{feat.title}</h3>
          <p class="text-sm text-body dark:text-[#a1a1a1] leading-relaxed">{feat.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
