---
const navLinks = [
  { label: 'Compress JPG', href: '/compress-jpg' },
  { label: 'Compress PNG', href: '/compress-png' },
  { label: 'Compress WebP', href: '/compress-webp' },
  { label: 'Reduce Size', href: '/reduce-image-size' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];
---

<header
  id="site-nav"
  class="sticky top-0 z-50 w-full bg-canvas/90 dark:bg-[#0a0a0a]/90 backdrop-blur-md border-b border-hairline dark:border-[#1f1f1f] transition-colors duration-200"
>
  <div class="container-page h-16 flex items-center justify-between gap-4">

    <!-- Logo -->
    <a
      href="/"
      class="flex items-center gap-2 shrink-0 group"
      aria-label="ImgCompressor Pro — Home"
    >
      <div class="w-7 h-7 rounded-md bg-ink dark:bg-white flex items-center justify-center shrink-0">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 2h5v5H2zM9 2h5v5H9zM2 9h5v5H2zM9 9h5v5H9z" fill="currentColor" class="text-canvas dark:text-ink" opacity="0.9"/>
          <path d="M5 5l6 6M11 5L5 11" stroke="currentColor" class="text-canvas dark:text-ink" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>
      <span class="text-sm font-semibold text-ink dark:text-white tracking-tight">
        ImgCompressor<span class="text-link"> Pro</span>
      </span>
    </a>

    <!-- Desktop nav links -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="px-3 py-1.5 text-sm text-body dark:text-[#a1a1a1] hover:text-ink dark:hover:text-white rounded-full hover:bg-canvas-soft-2 dark:hover:bg-[#1a1a1a] transition-colors duration-150 whitespace-nowrap"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right cluster -->
    <div class="flex items-center gap-2">

      <!-- Dark mode toggle -->
      <button
        id="dark-toggle"
        aria-label="Toggle dark mode"
        class="w-8 h-8 flex items-center justify-center rounded-full border border-hairline dark:border-[#2a2a2a] bg-canvas dark:bg-[#111] text-body dark:text-[#a1a1a1] hover:text-ink dark:hover:text-white hover:border-hairline-strong dark:hover:border-[#444] transition-all duration-150 cursor-pointer"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg id="icon-sun" class="hidden dark:block w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg id="icon-moon" class="dark:hidden w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <!-- CTA -->
      <a
        href="/#compressor"
        class="hidden sm:flex items-center h-8 px-3 bg-ink dark:bg-white text-white dark:text-ink text-sm font-medium rounded-md hover:bg-[#2a2a2a] dark:hover:bg-[#e5e5e5] transition-colors duration-150 whitespace-nowrap"
      >
        Compress Now
      </a>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        aria-label="Open menu"
        aria-expanded="false"
        class="md:hidden w-8 h-8 flex items-center justify-center rounded-md border border-hairline dark:border-[#2a2a2a] text-body dark:text-[#a1a1a1]"
      >
        <svg id="icon-menu" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="icon-close" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu overlay -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-hairline dark:border-[#1f1f1f] bg-canvas dark:bg-[#0a0a0a]"
  >
    <nav class="container-page py-4 flex flex-col gap-1" aria-label="Mobile navigation">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="px-3 py-2.5 text-sm text-body dark:text-[#a1a1a1] hover:text-ink dark:hover:text-white rounded-md hover:bg-canvas-soft dark:hover:bg-[#111] transition-colors"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-3 mt-2 border-t border-hairline dark:border-[#1f1f1f]">
        <a
          href="/#compressor"
          class="flex items-center justify-center h-10 bg-ink dark:bg-white text-white dark:text-ink text-sm font-medium rounded-lg"
        >
          Compress Images Now
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('dark-toggle');
  toggle?.addEventListener('click', () => {
    (window as any).__toggleDark?.();
  });

  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  mobileBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden', isOpen);
    iconMenu?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    mobileBtn.setAttribute('aria-expanded', String(!isOpen));
  });

  // Close mobile menu on resize
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) {
      mobileMenu?.classList.add('hidden');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      mobileBtn?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
