---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import ImageCompressor from '../components/ImageCompressor.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
import AdSlot from '../components/AdSlot.astro';

const faqItems = [
  {
    question: 'What is the fastest way to reduce image file size?',
    answer: 'The fastest method is compression via our tool — drop your image and click Compress. For JPEGs, an 80% quality re-encode typically saves 40–60% of the file size in under a second with no visible quality change.',
  },
  {
    question: 'Does reducing image size affect print quality?',
    answer: 'File size reduction through compression does not change the pixel dimensions of the image, so print resolution (DPI) is unaffected by the number of pixels. However, aggressive compression (below 70% quality) may introduce artifacts visible in large prints.',
  },
  {
    question: 'What is a good file size for web images?',
    answer: 'As a general guide: hero images < 200 KB, product images < 100 KB, thumbnails < 30 KB, background textures < 50 KB. Total image weight per page should ideally stay under 500 KB for fast load times.',
  },
  {
    question: 'Can I reduce image size without changing dimensions?',
    answer: 'Yes. ImgCompressor Pro preserves original pixel dimensions (width × height) while reducing file size through compression. If you also want to resize (reduce dimensions), you\'ll need an image resizing tool.',
  },
];
---

<Layout
  title="Reduce Image File Size Online Free | ImgCompressor Pro"
  description="Reduce image file size online without losing quality. Compress JPG, PNG, and WebP images up to 85% smaller. Free, instant, browser-based — no upload required."
  keywords="reduce image size, reduce image file size, image size reducer, make image smaller, decrease image size, compress image file, reduce photo size online, compress image to 100kb, compress image to 50kb, compress image to 20kb, compress image to 200kb, resize and compress image, free image size reducer"
>
  <Nav />
  <main>
    <HeroSection
      headline="Reduce image file size in seconds."
      subheadline="Compress any image up to 85% smaller without visible quality loss. Free, instant, and completely private."
      cta="Reduce Image Size Now"
    />

    <AdSlot slot="leaderboard" class="bg-canvas-soft dark:bg-[#0a0a0a]" />
    <div class="bg-canvas-soft dark:bg-[#0a0a0a]"><ImageCompressor /></div>

    <section class="py-16 bg-canvas dark:bg-[#111] border-y border-hairline dark:border-[#1f1f1f]">
      <div class="container-page max-w-3xl">
        <h2 class="text-2xl font-semibold text-ink dark:text-white mb-5 tracking-tight" style="letter-spacing: -0.6px;">
          How to reduce image file size effectively.
        </h2>
        <div class="space-y-4 text-sm text-body dark:text-[#a1a1a1] leading-relaxed">
          <p>
            Large image files are the leading cause of slow websites, failed email attachments, and storage issues.
            Understanding how to reduce image file size effectively — without sacrificing quality — is essential for
            web developers, photographers, marketers, and anyone who works with digital images.
          </p>
          <h3 class="text-base font-semibold text-ink dark:text-white mt-6">Three ways to reduce image file size:</h3>
          <ol class="list-decimal pl-5 space-y-3">
            <li>
              <strong class="text-ink dark:text-white">Compression</strong> — Re-encode the image at a lower quality level.
              For JPEG and WebP, this discards imperceptible high-frequency detail. This is the approach ImgCompressor Pro uses
              and is the most effective method, typically achieving 40–85% size reduction.
            </li>
            <li>
              <strong class="text-ink dark:text-white">Resizing</strong> — Reduce the pixel dimensions (e.g., from 4000×3000 to 1920×1080).
              Fewer pixels means smaller file. Best when the image is larger than it needs to be displayed.
            </li>
            <li>
              <strong class="text-ink dark:text-white">Format conversion</strong> — Convert to a more efficient format.
              WebP is typically 25–35% smaller than JPEG at the same quality.
              <a href="/compress-webp" class="text-link hover:text-link-deep">Learn about WebP compression.</a>
            </li>
          </ol>
          <p>
            For most situations, starting with compression (step 1) is the best approach because it requires the least
            effort and has the smallest impact on image quality.
          </p>
        </div>
      </div>
    </section>

    <FAQSection items={faqItems} />
    <AdSlot slot="banner" class="bg-canvas-soft dark:bg-[#0a0a0a]" />
    <CTASection headline="Reduce your image sizes now." />
  </main>
  <Footer />
</Layout>
