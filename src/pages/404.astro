---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="404 — Page Not Found | ImgCompressor Pro"
  description="The page you're looking for doesn't exist or has been moved."
  noindex={true}
>
  <Nav />
  <main class="py-24 md:py-32">
    <div class="container-page max-w-xl text-center">

      <span class="inline-block text-xs font-mono text-link bg-link/10 dark:bg-link/20 px-2.5 py-1 rounded-full mb-6">Error</span>

      <p class="text-[9rem] md:text-[12rem] font-semibold leading-none tracking-tight text-transparent bg-clip-text bg-gradient-to-b from-ink/20 to-ink/5 dark:from-white/15 dark:to-white/5 select-none mb-2" aria-hidden="true">
        404
      </p>

      <h1 class="text-2xl md:text-3xl font-semibold text-ink dark:text-white tracking-tight mb-3" style="letter-spacing:-0.6px;">
        Page not found
      </h1>

      <p class="text-sm text-body dark:text-[#a1a1a1] leading-relaxed mb-10 max-w-sm mx-auto">
        The page you're looking for doesn't exist or may have been moved. Double-check the URL, or head back to the homepage.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/"
          class="flex items-center h-10 px-5 bg-ink dark:bg-white text-white dark:text-ink text-sm font-medium rounded-lg hover:bg-[#2a2a2a] dark:hover:bg-[#e5e5e5] transition-colors duration-150"
        >
          Go to Homepage
        </a>
        <a
          href="/#compress"
          class="flex items-center h-10 px-5 border border-hairline dark:border-[#2a2a2a] text-ink dark:text-white text-sm font-medium rounded-lg hover:bg-canvas-soft dark:hover:bg-[#111] transition-colors duration-150"
        >
          Compress an Image
        </a>
      </div>

      <!-- Quick links -->
      <div class="mt-14 pt-8 border-t border-hairline dark:border-[#1f1f1f]">
        <p class="text-xs font-mono text-mute dark:text-[#555] mb-4">Popular pages</p>
        <div class="flex flex-wrap justify-center gap-2">
          {[
            { href: '/compress-jpg', label: 'Compress JPG' },
            { href: '/compress-png', label: 'Compress PNG' },
            { href: '/compress-webp', label: 'Compress WebP' },
            { href: '/reduce-image-size', label: 'Reduce Image Size' },
            { href: '/about', label: 'About' },
            { href: '/contact', label: 'Contact' },
          ].map(link => (
            <a
              href={link.href}
              class="text-xs text-body dark:text-[#888] hover:text-ink dark:hover:text-white border border-hairline dark:border-[#2a2a2a] rounded-full px-3 py-1 transition-colors duration-150"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>

    </div>
  </main>
  <Footer />
</Layout>
